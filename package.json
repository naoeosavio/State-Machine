{
  "name": "@uwu-games/uwu-state-machine",
  "version": "0.1.0",
  "description": "Game tick system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
