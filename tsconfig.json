{
  "compilerOptions": {
    "target": "ES2022",                          
    "module": "ESNEXT",                      
    "strict": true,                           
    "declaration": true,
    "esModuleInterop": true,                  
    "skipLibCheck": true,                     
    "forceConsistentCasingInFileNames": true, 
    "outDir": "./dist",                       
    "rootDir": "./src", 
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
