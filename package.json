    "test": "npm run test:main && npm run test:orchestrator && npm run test:layer2 && npm run test:seams && npm run test:backlog",
    "test:main": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' test/main.test.ts",
    "test:orchestrator": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' test/orchestrator.test.ts",
    "test:layer2": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' test/layer2.test.ts",
    "test:seams": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' test/seams.test.ts",
    "test:backlog": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' test/backlog.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UwU-Jogos/State-Machine.git"
  },
  "keywords": [
    "real-time",
    "state",
    "gaming",
    "tick-system",
    "machine"
  ],
  "author": "Victor Taelin <victor.taelin@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/UwU-Jogos/State-Machine/issues"
  },
  "homepage": "https://github.com/UwU-Jogos/State-Machine#readme",
  "devDependencies": {
    "@types/node": "20.19.43",
    "rimraf": "5.0.10",
    "ts-node": "10.9.2",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lite-fp": "0.8.0"
  }
